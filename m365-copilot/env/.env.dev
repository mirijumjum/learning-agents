# Agents Toolkit environment "dev" (a real tenant). Committed values are not secrets.
# Secrets go in env/.env.dev.user (git-ignored). Values left empty are written by "Provision".
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=

# Public https URL of the deployed DevAssist actions API (without /api).
DEVASSIST_ACTIONS_URL=https://devassist-actions.example.com

# Shown in the app and plugin manifests.
DEVASSIST_DEVELOPER_NAME=Your company
DEVASSIST_WEBSITE_URL=https://www.example.com
DEVASSIST_PRIVACY_URL=https://www.example.com/privacy
DEVASSIST_TERMS_URL=https://www.example.com/terms
DEVASSIST_CONTACT_EMAIL=devassist-owner@example.com

# Fixed id of the DevAssist.Use scope in the Entra app (any GUID, keep it stable).
AAD_APP_ACCESS_AS_USER_PERMISSION_ID=fc9691ce-b3b0-4957-85ff-4c1866f784ae

# Written by Provision:
TEAMS_APP_ID=
AAD_APP_CLIENT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY=
AAD_APP_OAUTH_AUTHORITY_HOST=
ENTRA_SSO_CONFIGURATION_ID=
ENTRA_SSO_APPLICATION_ID_URI=
M365_TITLE_ID=
M365_APP_ID=
