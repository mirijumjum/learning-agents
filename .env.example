# Copy this file to .env, fill in ONE provider and load it with:
#   set -a; source .env; set +a
# Never commit .env (it is already in .gitignore).

# --- Azure OpenAI (--provider azure) -------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key from the Azure portal: resource -> Keys and Endpoint>
AZURE_OPENAI_MODEL=<your deployment name, e.g. agent-lab-model>
# AZURE_OPENAI_API_VERSION=<optional, the library has a sensible default>

# --- OpenAI or any OpenAI-compatible server (--provider openai) ----------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=<model name>
# OPENAI_BASE_URL=http://localhost:11434/v1   # optional, e.g. a local Ollama

# --- Anthropic (--provider anthropic, needs: pip install -e '.[anthropic]')
# ANTHROPIC_API_KEY=...
# ANTHROPIC_CHAT_MODEL=<model name>

# --- Misc -----------------------------------------------------------------
# NO_COLOR=1   # disable colored output
