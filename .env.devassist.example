# Copy to .env.devassist (git-ignored). DevAssist loads it automatically.
# As written, this is the free local setup: Ollama plus the GitLab stand-in.

# --- Which models: mock | ollama | azure | openai-compatible --------------
DEVASSIST_PROFILE=ollama
# OLLAMA_MODEL_STRONG=qwen3:8b
# OLLAMA_MODEL_FAST=qwen3:4b

# --- Self-hosted model server (vLLM, Ollama's /v1, llama.cpp, LiteLLM) -----
# See deploy/self-hosted/ and docs/ALTERNATIVA-self-hosted.md.
# DEVASSIST_PROFILE=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://gpu-server:8000/v1
# OPENAI_COMPATIBLE_BASE_URL_FAST=<only if the fast model runs on another server>
# OPENAI_COMPATIBLE_MODEL_STRONG=gpt-oss-20b
# OPENAI_COMPATIBLE_MODEL_FAST=gpt-oss-20b
# OPENAI_COMPATIBLE_API_KEY=<the --api-key given to vLLM; empty if none>
# How the reasoning level is sent: effort (gpt-oss, Ollama) | thinking-flag (Qwen3 on vLLM) | omit
# OPENAI_COMPATIBLE_REASONING_MODE=effort
# gpt-oss only accepts low|medium|high, so set this with gpt-oss (default: none):
# DEVASSIST_REASONING_EFFORT=low

# --- GitLab: defaults to the stand-in from `devassist fake-gitlab` --------
GITLAB_URL=http://127.0.0.1:8929
GITLAB_TOKEN=local-dev-token
GITLAB_PROJECTS=acme/payments-api,acme/customer-portal
# DEVASSIST_DEFAULT_PROJECT=acme/payments-api
# Maps Teams e-mail to GitLab username, for "assigned to me":
# DEVASSIST_USER_MAP={"ana@acme.com": "ana.garcia"}

# --- Webhooks: rejected until a secret is set; each automation is opt-in --
# GITLAB_WEBHOOK_SECRET=<long random value, same as in GitLab's webhook settings>
# DEVASSIST_AUTO_TESTS_ON_MR=true
# DEVASSIST_AUTO_CHANGELOG_ON_MERGE=true
# DEVASSIST_AUTO_TRACE_ON_PIPELINE_FAILURE=true
# TEAMS_NOTIFY_WEBHOOK_URL=<Teams workflow webhook, to also post results to a channel>

# --- Logs: jsonl | azure | elasticsearch ----------------------------------
DEVASSIST_LOG_STORE=jsonl
# DEVASSIST_TIMEZONE=Europe/Madrid
# ELASTIC_URL=https://elastic.acme.com:9200
# ELASTIC_API_KEY=<key with read privilege only>
# ELASTIC_INDEX=logs-*

# --- Cost limits ----------------------------------------------------------
# DEVASSIST_MAX_DIFF_CHARS=60000
# DEVASSIST_MAX_OUTPUT_TOKENS=4000
# DEVASSIST_MAX_TEST_ATTEMPTS=3
# Reasoning shares the output limit. Default: none on Ollama and openai-compatible, low on Azure.
# DEVASSIST_REASONING_EFFORT=low

# --- Paid setup. infra/main.bicep sets all of these on the container app. --
# DEVASSIST_PROFILE=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_STRONG=gpt-5
# AZURE_OPENAI_DEPLOYMENT_FAST=gpt-5-mini
# AZURE_OPENAI_API_KEY=<leave empty to use the managed identity, as production does>
# DEVASSIST_ALLOWED_TENANT_ID=<tenant GUID>
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<managed identity client id>
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant GUID>
# DEVASSIST_LOG_STORE=azure
# LOG_ANALYTICS_WORKSPACE_ID=<workspace GUID>
# APPLICATIONINSIGHTS_CONNECTION_STRING=<from Application Insights>
