{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devassist/gitlab-duo/agent-config",
  "title": ".gitlab/duo/agent-config.yml (flow execution environment)",
  "description": "Keys from https://docs.gitlab.com/user/duo_agent_platform/flows/execution/ (checked 2026-11-10).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {"type": "string"},
    "setup_script": {"type": "array", "items": {"type": "string"}},
    "cache": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "key": {
          "oneOf": [
            {"type": "string"},
            {"type": "object", "properties": {"files": {"type": "array", "maxItems": 10, "items": {"type": "string"}}, "prefix": {"type": "string"}}}
          ]
        },
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "id_tokens": {"type": "object", "additionalProperties": {"type": "object", "required": ["aud"]}},
    "network_policy": {
      "type": "object",
      "properties": {"allowed_domains": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
