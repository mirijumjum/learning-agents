{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devassist/gitlab-duo/mr-review-instructions",
  "title": ".gitlab/duo/mr-review-instructions.yaml",
  "description": "From https://docs.gitlab.com/user/duo_agent_platform/customize/review_instructions/ (checked 2026-11-10).",
  "type": "object",
  "required": ["instructions"],
  "additionalProperties": false,
  "properties": {
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "instructions"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "fileFilters": {"type": "array", "items": {"type": "string"}},
          "instructions": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
