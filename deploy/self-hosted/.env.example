# Copy to .env next to docker-compose.yml (git-ignored). Used by Compose and by the DevAssist container.

# --- Public name for Teams -------------------------------------------------
# Must resolve to this server and reach ports 80/443 from the internet (Let's Encrypt).
DEVASSIST_DOMAIN=devassist.example.com

# --- Teams bot identity (free: Teams Developer Portal > Tools > Bot management, or an Azure Bot) --
# Messaging endpoint to register there: https://<DEVASSIST_DOMAIN>/api/messages
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=ClientSecret
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<bot app (client) id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<bot client secret>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<your tenant GUID>
DEVASSIST_ALLOWED_TENANT_ID=<your tenant GUID>

# --- Models: any OpenAI-compatible server ------------------------------------
# Default: the ollama service in this compose file (CPU). Strong and fast can be the same model.
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_MODEL_STRONG=qwen3:8b
OPENAI_COMPATIBLE_MODEL_FAST=qwen3:4b
OPENAI_COMPATIBLE_API_KEY=change-me-long-random-value
# effort: reasoning_effort field (Ollama, gpt-oss) | thinking-flag: Qwen3 on vLLM | omit
OPENAI_COMPATIBLE_REASONING_MODE=effort
# Small models answer better and faster with reasoning off. gpt-oss only accepts low|medium|high.
DEVASSIST_REASONING_EFFORT=none
DEVASSIST_LLM_TIMEOUT=180

# --- vLLM (docker compose --profile gpu) -------------------------------------
# Uncomment, and comment the Ollama block above. 24 GB GPU: gpt-oss-20b. 80-96 GB: gpt-oss-120b
# or Qwen/Qwen3-30B-A3B-Instruct-2507 (with VLLM_TOOL_PARSER=hermes and REASONING_MODE=omit).
# OPENAI_COMPATIBLE_BASE_URL=http://vllm:8000/v1
# OPENAI_COMPATIBLE_MODEL_STRONG=gpt-oss-20b
# OPENAI_COMPATIBLE_MODEL_FAST=gpt-oss-20b
# OPENAI_COMPATIBLE_REASONING_MODE=effort
# DEVASSIST_REASONING_EFFORT=low
# VLLM_MODEL=openai/gpt-oss-20b
# VLLM_TOOL_PARSER=openai
# VLLM_MAX_MODEL_LEN=32768
# VLLM_EXTRA_ARGS=
# HF_TOKEN=<only for gated models; gpt-oss and Qwen3 are not gated>

# --- GitLab -------------------------------------------------------------------
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=<bot user token, scope api, Developer role on the pilot projects only>
GITLAB_PROJECTS=group/payments-api,group/customer-portal
GITLAB_WEBHOOK_SECRET=<long random value, same as in GitLab's webhook settings>
# DEVASSIST_USER_MAP={"ana@example.com": "ana.garcia"}

# --- Logs: jsonl | elasticsearch (Log Analytics is the Azure option) ------------
DEVASSIST_LOG_STORE=elasticsearch
ELASTIC_URL=https://elastic.example.com:9200
ELASTIC_API_KEY=<key with read privilege only>
ELASTIC_INDEX=logs-*
DEVASSIST_TIMEZONE=Europe/Madrid
